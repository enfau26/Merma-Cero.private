NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Compatibilidad con proyectos que todavía usan la clave anon: puede usarse en su lugar.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
NEXT_PUBLIC_APP_URL=http://localhost:3000
# En producción, NEXT_PUBLIC_APP_URL debe ser la URL HTTPS pública exacta.
# Nunca añadir SUPABASE_SERVICE_ROLE_KEY al frontend ni a este archivo.
